<!DOCTYPE html>
<html lang="en" class="dark h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AURA-Civic | Real-Time Civic Intelligence & Spatial Anomaly Engine</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    // ==========================================
    // GOOGLE MAPS EMBED API KEY CONFIGURATION
    // ==========================================
    // Replace 'YOUR_GOOGLE_MAPS_API_KEY' with your actual Google Maps API key
    let GOOGLE_MAPS_API_KEY = "YOUR_GOOGLE_MAPS_API_KEY";

    /**
     * Generates a Google Maps Embed iframe URL using the configured API Key.
     * Falls back to standard embed if no key is supplied.
     * @param {string} locationQuery - Location query, address, or landmark.
     * @param {string} mode - Embed mode: 'place', 'search', 'directions', or 'view'.
     * @returns {string} Fully qualified iframe src URL.
     */
    function getGoogleMapsEmbedUrl(locationQuery, mode = 'place') {
      const encodedQuery = encodeURIComponent(locationQuery);
      
      // Use official Google Maps Embed API v1 when a key is available
      if (GOOGLE_MAPS_API_KEY && GOOGLE_MAPS_API_KEY !== "YOUR_GOOGLE_MAPS_API_KEY") {
        return `https://www.google.com/maps/embed/v1/${mode}?key=${GOOGLE_MAPS_API_KEY}&q=${encodedQuery}`;
      }
      
      // Fallback preview URL when API Key is pending
      return `https://maps.google.com/maps?q=${encodedQuery}&t=&z=13&ie=UTF8&iwloc=&output=embed`;
    }

    /**
     * Updates the Google Maps API Key dynamically from UI controls or input
     * @param {string} newApiKey - The Google Maps API key string
     */
    function setGoogleMapsApiKey(newApiKey) {
      if (newApiKey && newApiKey.trim() !== '') {
        GOOGLE_MAPS_API_KEY = newApiKey.trim();
        localStorage.setItem('google_maps_api_key', GOOGLE_MAPS_API_KEY);
        
        // Refresh active map elements on the page
        document.querySelectorAll('iframe[data-map-location]').forEach(iframe => {
          const location = iframe.getAttribute('data-map-location');
          iframe.src = getGoogleMapsEmbedUrl(location);
        });
      }
    }

    // Load persisted API key on initialization if previously saved
    (function initApiKey() {
      const savedKey = localStorage.getItem('google_maps_api_key');
      if (savedKey) {
        GOOGLE_MAPS_API_KEY = savedKey;
      }
    })();
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Leaflet GIS Map -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <!-- Chart.js UMD bundle -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>

  <style>
    /* Custom Scrollbar & Cyberpunk glassmorphism tweaks */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); }
    ::-webkit-scrollbar-thumb { background: rgba(0, 242, 254, 0.25); border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(0, 242, 254, 0.5); }

    .glass-card {
      background: rgba(15, 23, 42, 0.7);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    
    .glass-card-glow {
      box-shadow: 0 0 20px rgba(0, 242, 254, 0.05);
    }

    .pulse-glow-critical {
      animation: pulseCritical 1.8s infinite;
    }
    @keyframes pulseCritical {
      0%, 100% { box-shadow: 0 0 0 0 rgba(247, 37, 133, 0.7); }
      50% { box-shadow: 0 0 15px 4px rgba(247, 37, 133, 0.4); }
    }

    .pulse-glow-caution {
      animation: pulseCaution 2s infinite;
    }
    @keyframes pulseCaution {
      0%, 100% { box-shadow: 0 0 0 0 rgba(255, 183, 3, 0.6); }
      50% { box-shadow: 0 0 12px 3px rgba(255, 183, 3, 0.3); }
    }

    /* Leaflet Dark Theme Adjustments */
    .leaflet-container {
      background: #090d16 !important;
      font-family: 'Inter', sans-serif !important;
    }
    .leaflet-tile-pane { filter: brightness(0.7) invert(1) contrast(3) hue-rotate(200deg) saturate(0.3); }
    .leaflet-control-zoom a {
      background-color: rgba(15, 23, 42, 0.9) !important;
      color: #00f2fe !important;
      border-color: rgba(255, 255, 255, 0.1) !important;
    }

    /* Hex Polygon animations */
    .hex-poly {
      transition: all 0.4s ease;
      cursor: pointer;
    }
    .hex-poly:hover {
      fill-opacity: 0.85 !important;
      stroke-width: 3px !important;
      filter: drop-shadow(0 0 8px rgba(0,242,254,0.8));
    }
  </style>
</head>

<body class="h-full flex flex-col font-sans bg-[#090d16] text-slate-100 overflow-hidden select-none">

  <header class="h-16 border-b border-white/10 bg-slate-900/80 backdrop-blur-md px-4 flex items-center justify-between shrink-0 z-30">
    <div class="flex items-center space-x-3">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-teal via-brand-emerald to-brand-violet p-0.5 flex items-center justify-center shadow-lg shadow-cyan-500/20">
        <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
          <i class="fa-solid fa-city text-brand-teal text-lg"></i>
        </div>
      </div>
      <div>
        <div class="flex items-center space-x-2">
          <span class="font-bold tracking-wider text-base bg-clip-text text-transparent bg-gradient-to-r from-brand-teal via-teal-200 to-brand-emerald">
            AURA-CIVIC
          </span>
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-brand-teal/10 text-brand-teal border border-brand-teal/30">v3.4-PRO</span>
        </div>
        <p class="text-[11px] text-slate-400 font-mono tracking-tight">Real-Time Spatial Fusion & Anomaly Intelligence</p>
      </div>
    </div>

    <!-- Live Simulation Controls -->
    <div class="flex items-center space-x-3 bg-slate-950/80 p-1.5 rounded-xl border border-white/10">
      <button id="btn-toggle-sim" onclick="toggleSimulation()" class="px-3 py-1.5 rounded-lg bg-brand-teal/20 hover:bg-brand-teal/30 text-brand-teal border border-brand-teal/40 text-xs font-semibold flex items-center space-x-2 transition">
        <i id="sim-play-icon" class="fa-solid fa-pause"></i>
        <span id="sim-play-text">PAUSE SIM</span>
      </button>

      <div class="flex items-center space-x-1 border-l border-white/10 pl-2">
        <span class="text-[11px] font-mono text-slate-400 mr-1">SPEED:</span>
        <button onclick="setSimSpeed(1)" id="speed-1x" class="px-2 py-1 rounded text-xs font-mono bg-brand-teal/20 text-brand-teal border border-brand-teal/40">1x</button>
        <button onclick="setSimSpeed(2)" id="speed-2x" class="px-2 py-1 rounded text-xs font-mono text-slate-400 hover:text-slate-200">2x</button>
        <button onclick="setSimSpeed(5)" id="speed-5x" class="px-2 py-1 rounded text-xs font-mono text-slate-400 hover:text-slate-200">5x</button>
      </div>

      <!-- Incident Presets Trigger -->
      <div class="relative border-l border-white/10 pl-2">
        <select id="preset-scenario-select" onchange="injectScenario(this.value)" class="bg-slate-900 text-xs font-mono text-brand-teal border border-brand-teal/30 rounded-lg px-2.5 py-1.5 focus:outline-none focus:border-brand-teal">
          <option value="" disabled selected>⚡ Inject Scenario Preset...</option>
          <option value="water_main">💧 Water Main Break & Traffic Spike</option>
          <option value="extreme_heat">🔥 Extreme Heatwave & Grid Strain</option>
          <option value="noise_transit">🔊 Concert Noise & Transit Bottleneck</option>
          <option value="air_quality">🏭 Industrial Emission & AQI Spike</option>
          <option value="reset">🔄 Reset All Streams to Baseline</option>
        </select>
      </div>
    </div>

    <!-- Status Indicator & Settings Modal Toggle -->
    <div class="flex items-center space-x-4">
      <div class="flex items-center space-x-2 bg-slate-950/60 px-3 py-1.5 rounded-lg border border-white/5">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span class="text-xs font-mono text-slate-300">STREAM: <span class="text-brand-emerald font-semibold" id="clock-display">00:00:00</span></span>
      </div>

      <button onclick="openConfigModal()" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center border border-white/10 transition relative">
        <i class="fa-solid fa-sliders"></i>
        <span id="api-key-indicator" class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-slate-500"></span>
      </button>
    </div>
  </header>

  <div class="flex flex-1 h-[calc(100vh-4rem)] overflow-hidden">
    
    <!-- Sidebar Navigation -->
    <aside class="w-16 border-r border-white/10 bg-slate-900/60 backdrop-blur-md flex flex-col items-center py-4 space-y-5 shrink-0 z-20">
      <button onclick="switchView('overview')" id="nav-overview" title="Dashboard Overview" class="nav-btn w-10 h-10 rounded-xl flex items-center justify-center text-brand-teal bg-brand-teal/15 border border-brand-teal/30 transition">
        <i class="fa-solid fa-chart-pie"></i>
      </button>
      <button onclick="switchView('spatial')" id="nav-spatial" title="Spatial Anomaly Heatmap" class="nav-btn w-10 h-10 rounded-xl flex items-center justify-center text-slate-400 hover:text-slate-100 hover:bg-slate-800 border border-transparent transition">
        <i class="fa-solid fa-map-location-dot"></i>
      </button>
      <button onclick="switchView('correlation')" id="nav-correlation" title="Cross-Stream Correlation" class="nav-btn w-10 h-10 rounded-xl flex items-center justify-center text-slate-400 hover:text-slate-100 hover:bg-slate-800 border border-transparent transition">
        <i class="fa-solid fa-network-wired"></i>
      </button>
      <button onclick="switchView('narrative')" id="nav-narrative" title="AI Neighborhood Summarizer" class="nav-btn w-10 h-10 rounded-xl flex items-center justify-center text-slate-400 hover:text-slate-100 hover:bg-slate-800 border border-transparent transition">
        <i class="fa-solid fa-brain"></i>
      </button>
      <button onclick="switchView('inspector')" id="nav-inspector" title="Live Stream Inspector" class="nav-btn w-10 h-10 rounded-xl flex items-center justify-center text-slate-400 hover:text-slate-100 hover:bg-slate-800 border border-transparent transition">
        <i class="fa-solid fa-list-check"></i>
      </button>
      
      <div class="mt-auto flex flex-col items-center space-y-3">
        <button onclick="exportReport('pdf')" title="Export Summary PDF" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center text-xs transition">
          <i class="fa-solid fa-file-pdf text-red-400"></i>
        </button>
        <button onclick="exportReport('json')" title="Export Raw Stream JSON" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center text-xs transition">
          <i class="fa-solid fa-file-code text-brand-teal"></i>
        </button>
      </div>
    </aside>

    <!-- Main Workspace Content Area -->
    <main class="flex-1 flex flex-col overflow-hidden bg-[#090d16] relative">
      
      <!-- VIEW 1: MAIN DASHBOARD OVERVIEW -->
      <div id="view-overview" class="view-panel h-full flex flex-col p-4 space-y-4 overflow-y-auto">
        
        <!-- Top Row Cards: Selected District Quick Metrics -->
        <div class="grid grid-cols-1 md:grid-cols-5 gap-3 shrink-0">
          
          <!-- District Selector Header Card -->
          <div class="glass-card rounded-2xl p-3.5 flex flex-col justify-between border-brand-teal/20 bg-gradient-to-br from-slate-900/90 via-slate-900/70 to-slate-950">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">SELECTED TARGET</span>
              <span id="district-status-badge" class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                STABLE
              </span>
            </div>
            <div>
              <select id="district-selector" onchange="changeSelectedDistrict(this.value)" class="w-full bg-slate-950 text-base font-bold text-slate-100 border border-white/10 rounded-xl px-2.5 py-1.5 focus:outline-none focus:border-brand-teal cursor-pointer">
                <!-- Dynamically populated -->
              </select>
              <div class="text-[11px] text-slate-400 font-mono mt-1 flex justify-between">
                <span>H3 Res-8 Hexagon</span>
                <span id="h3-index-display" class="text-brand-teal">#882a100d2bffff</span>
              </div>
            </div>
          </div>

          <!-- Metric 1: 311 Surge Rate -->
          <div class="glass-card rounded-2xl p-3.5 flex flex-col justify-between">
            <div class="flex justify-between items-start">
              <div>
                <span class="text-[10px] font-mono text-slate-400 uppercase">311 COMPLAINT RATE</span>
                <h4 id="metric-311-val" class="text-xl font-bold font-mono text-slate-100">12 <span class="text-xs text-slate-400 font-normal">req/hr</span></h4>
              </div>
              <div class="w-8 h-8 rounded-lg bg-cyan-500/10 flex items-center justify-center text-brand-teal">
                <i class="fa-solid fa-phone-volume"></i>
              </div>
            </div>
            <div class="flex items-center justify-between text-[11px] font-mono mt-2">
              <span class="text-slate-400">Baseline: 10</span>
              <span id="metric-311-zscore" class="text-brand-emerald">Z: +0.4</span>
            </div>
          </div>

          <!-- Metric 2: Traffic Speed Index -->
          <div class="glass-card rounded-2xl p-3.5 flex flex-col justify-between">
            <div class="flex justify-between items-start">
              <div>
                <span class="text-[10px] font-mono text-slate-400 uppercase">AVG TRAFFIC SPEED</span>
                <h4 id="metric-traffic-val" class="text-xl font-bold font-mono text-slate-100">32 <span class="text-xs text-slate-400 font-normal">mph</span></h4>
              </div>
              <div class="w-8 h-8 rounded-lg bg-amber-500/10 flex items-center justify-center text-brand-amber">
                <i class="fa-solid fa-car-side"></i>
              </div>
            </div>
            <div class="flex items-center justify-between text-[11px] font-mono mt-2">
              <span class="text-slate-400">Baseline: 30 mph</span>
              <span id="metric-traffic-zscore" class="text-brand-emerald">Z: +0.2</span>
            </div>
          </div>

          <!-- Metric 3: Air Quality AQI -->
          <div class="glass-card rounded-2xl p-3.5 flex flex-col justify-between">
            <div class="flex justify-between items-start">
              <div>
                <span class="text-[10px] font-mono text-slate-400 uppercase">AIR QUALITY (AQI)</span>
                <h4 id="metric-aqi-val" class="text-xl font-bold font-mono text-slate-100">42 <span class="text-xs text-slate-400 font-normal">AQI</span></h4>
              </div>
              <div class="w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center text-brand-emerald">
                <i class="fa-solid fa-wind"></i>
              </div>
            </div>
            <div class="flex items-center justify-between text-[11px] font-mono mt-2">
              <span class="text-slate-400">Baseline: 35</span>
              <span id="metric-aqi-zscore" class="text-brand-emerald">Z: +0.5</span>
            </div>
          </div>

          <!-- Metric 4: Multi-Stream Isolation Anomaly Index -->
          <div class="glass-card rounded-2xl p-3.5 flex flex-col justify-between border-brand-teal/30 bg-slate-900/90">
            <div class="flex justify-between items-start">
              <div>
                <span class="text-[10px] font-mono text-slate-400 uppercase">FUSED ISOLATION SCORE</span>
                <h4 id="metric-iso-score" class="text-xl font-bold font-mono text-brand-teal">0.12</h4>
              </div>
              <div class="w-8 h-8 rounded-lg bg-brand-teal/15 flex items-center justify-center text-brand-teal">
                <i class="fa-solid fa-shield-halved"></i>
              </div>
            </div>
            <div class="w-full bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
              <div id="metric-iso-bar" class="bg-gradient-to-r from-brand-emerald via-brand-amber to-brand-magenta h-full transition-all duration-500" style="width: 12%"></div>
            </div>
          </div>

        </div>

        <!-- Middle Section: Leaflet GIS Map + Real-Time Telemetry Graph -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 flex-1 min-h-[380px]">
          
          <!-- Interactive Geo Spatial Map -->
          <div class="lg:col-span-7 glass-card rounded-2xl p-3 flex flex-col relative overflow-hidden">
            <div class="flex items-center justify-between mb-2 px-1 z-10">
              <div class="flex items-center space-x-2">
                <i class="fa-solid fa-layer-group text-brand-teal text-sm"></i>
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200">Municipal Hexagonal Anomaly Mesh</h3>
                <select id="map-layer-select" onchange="changeMapLayer(this.value)" class="ml-2 bg-slate-950 text-[10px] font-mono text-brand-teal border border-brand-teal/30 rounded-lg px-2 py-0.5 focus:outline-none">
                  <option value="carto-dark">Carto Dark (Default)</option>
                  <option value="gmaps-roadmap">Google Maps (Roadmap)</option>
                  <option value="gmaps-satellite">Google Maps (Satellite)</option>
                  <option value="gmaps-hybrid">Google Maps (Hybrid)</option>
                  <option value="gmaps-terrain">Google Maps (Terrain)</option>
                </select>
              </div>
              <div class="flex items-center space-x-3 text-[10px] font-mono">
                <span class="flex items-center"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500 mr-1.5"></span>Normal</span>
                <span class="flex items-center"><span class="w-2.5 h-2.5 rounded-full bg-amber-400 mr-1.5"></span>Caution</span>
                <span class="flex items-center"><span class="w-2.5 h-2.5 rounded-full bg-rose-500 mr-1.5"></span>Critical</span>
              </div>
            </div>
            
            <div id="spatial-map" class="w-full h-full rounded-xl z-0 border border-white/5"></div>

            <!-- Floating Quick Summary Tooltip -->
            <div class="absolute bottom-5 left-5 bg-slate-900/90 backdrop-blur-md p-3 rounded-xl border border-white/10 z-10 max-w-xs text-xs space-y-1 shadow-2xl">
              <div class="text-[10px] font-mono text-brand-teal flex justify-between">
                <span>ACTIVE SCENARIO:</span>
                <span id="map-active-scenario" class="font-bold">STANDARD BASELINE</span>
              </div>
              <p id="map-quick-desc" class="text-slate-300 text-[11px] leading-tight">
                All district sensors are operating within expected multi-variable standard deviations.
              </p>
            </div>
          </div>

          <!-- Real-time Telemetry Line Chart -->
          <div class="lg:col-span-5 glass-card rounded-2xl p-3.5 flex flex-col">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center space-x-2">
                <i class="fa-solid fa-chart-line text-brand-teal text-sm"></i>
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200">Dynamic Multi-Stream Telemetry</h3>
              </div>
              <select id="chart-stream-select" onchange="updateChartStream(this.value)" class="bg-slate-950 text-xs font-mono text-brand-teal border border-brand-teal/30 rounded-lg px-2 py-1 focus:outline-none">
                <option value="all">All Combined Streams</option>
                <option value="311">311 Complaint Volume</option>
                <option value="traffic">Traffic Speed (mph)</option>
                <option value="aqi">Air Quality (AQI)</option>
                <option value="noise">Noise Level (dB)</option>
                <option value="transit">Transit Delay (min)</option>
              </select>
            </div>

            <div class="flex-1 relative w-full h-full min-h-[260px]">
              <canvas id="telemetryChart"></canvas>
            </div>
          </div>

        </div>

        <!-- Bottom Section: AI Situation Narrative & Live Anomaly Log -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 h-64 shrink-0">
          
          <!-- AI Plain-Language Narrative Card -->
          <div class="lg:col-span-7 glass-card rounded-2xl p-4 flex flex-col justify-between border-brand-teal/20 relative overflow-hidden bg-gradient-to-r from-slate-900/90 via-slate-900/80 to-slate-950">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center space-x-2">
                <div class="w-6 h-6 rounded-lg bg-brand-teal/20 flex items-center justify-center text-brand-teal text-xs">
                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                </div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-100">AI Plain-Language Neighborhood Narrative</h3>
              </div>

              <div class="flex items-center space-x-2">
                <!-- Speech Synthesis Trigger -->
                <button onclick="speakNarrative()" id="btn-speak" title="Read Aloud with Voice Synthesis" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs flex items-center space-x-1.5 border border-white/10 transition">
                  <i class="fa-solid fa-volume-high text-brand-emerald"></i>
                  <span class="text-[11px] font-mono">LISTEN</span>
                </button>

                <!-- Gemini Generate Button -->
                <button onclick="generateAINarrative()" id="btn-generate-ai" class="px-3 py-1 rounded-lg bg-gradient-to-r from-brand-teal to-brand-emerald hover:opacity-90 text-slate-950 font-bold text-xs flex items-center space-x-2 transition shadow-lg shadow-cyan-500/20">
                  <i class="fa-solid fa-rotate text-xs"></i>
                  <span>GENERATE NARRATIVE</span>
                </button>
              </div>
            </div>

            <!-- Narrative Content Output -->
            <div id="narrative-box" class="flex-1 bg-slate-950/60 rounded-xl p-3 border border-white/5 overflow-y-auto text-xs text-slate-300 space-y-2 leading-relaxed">
              <p class="text-slate-400 italic">
                Click <strong class="text-brand-teal">"Generate Narrative"</strong> to synthesize real-time municipal telemetry, dynamic z-scores, cross-stream correlations, and active work orders into plain language using Gemini AI.
              </p>
            </div>

            <div class="flex items-center justify-between mt-2 pt-2 border-t border-white/5 text-[10px] font-mono text-slate-400">
              <span id="ai-model-tag">ENGINE: GEMINI 3.1 FLASH / HEURISTIC HYBRID</span>
              <span id="ai-timestamp">LAST UPDATED: NEVER</span>
            </div>
          </div>

          <!-- Live Anomaly Alert Log Feed -->
          <div class="lg:col-span-5 glass-card rounded-2xl p-4 flex flex-col">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center space-x-2">
                <i class="fa-solid fa-triangle-exclamation text-brand-amber text-sm"></i>
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200">Real-Time Anomaly Log</h3>
              </div>
              <span id="anomaly-count-badge" class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-brand-amber/20 text-brand-amber border border-brand-amber/30">
                0 ACTIVE ALERTS
              </span>
            </div>

            <!-- Alert Scroll Area -->
            <div id="anomaly-log-list" class="flex-1 overflow-y-auto space-y-2 pr-1 font-mono text-xs">
              <div class="text-slate-500 italic text-center py-6 text-xs">No active critical anomalies detected. System baseline healthy.</div>
            </div>
          </div>

        </div>

      </div>

      <!-- VIEW 2: SPATIAL ANOMALY HEATMAP VIEW -->
      <div id="view-spatial" class="view-panel hidden h-full p-4 flex-col space-y-4 overflow-y-auto">
        <div class="glass-card rounded-2xl p-4 flex justify-between items-center">
          <div>
            <h2 class="text-lg font-bold text-slate-100 flex items-center space-x-2">
              <i class="fa-solid fa-map-location-dot text-brand-teal"></i>
              <span>Spatial Anomaly Mesh & District Breakdown</span>
            </h2>
            <p class="text-xs text-slate-400">H3 Hexagonal Spatial Index resolution 8 cross-analyzing all municipal stream coordinates.</p>
          </div>
          <button onclick="switchView('overview')" class="px-3 py-1.5 rounded-xl bg-slate-800 text-xs font-mono text-slate-300 hover:bg-slate-700">
            ← Return to Dashboard
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 flex-1">
          <!-- District Detail Cards Grid -->
          <div id="spatial-districts-grid" class="md:col-span-3 grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Dynamically populated district cards -->
          </div>
        </div>
      </div>

      <!-- VIEW 3: CROSS-STREAM CORRELATION MATRIX -->
      <div id="view-correlation" class="view-panel hidden h-full p-4 flex flex-col space-y-4 overflow-y-auto">
        <div class="glass-card rounded-2xl p-4 flex justify-between items-center shrink-0">
          <div>
            <h2 class="text-lg font-bold text-slate-100 flex items-center space-x-2">
              <i class="fa-solid fa-network-wired text-brand-teal"></i>
              <span>Real-Time Cross-Stream Pearson Correlation Matrix</span>
            </h2>
            <p class="text-xs text-slate-400">Dynamically computes covariance and correlation coefficients across 15-minute sliding stream windows to isolate hidden systemic relationships.</p>
          </div>
          <button onclick="switchView('overview')" class="px-3 py-1.5 rounded-xl bg-slate-800 text-xs font-mono text-slate-300 hover:bg-slate-700">
            ← Return to Dashboard
          </button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 flex-1">
          <!-- Correlation Heatmap Matrix Table -->
          <div class="lg:col-span-7 glass-card rounded-2xl p-4 flex flex-col justify-between">
            <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Stream Pearson Correlation Coefficient ($r$) Matrix</h3>
            <div class="overflow-x-auto flex-1 flex items-center justify-center">
              <table id="correlation-table" class="w-full text-center border-collapse font-mono text-xs">
                <!-- Dynamically populated -->
              </table>
            </div>
            <div class="flex justify-between items-center text-[11px] font-mono text-slate-400 mt-4 pt-2 border-t border-white/5">
              <span class="flex items-center space-x-1"><span class="w-3 h-3 bg-cyan-500/30 border border-cyan-400 inline-block rounded"></span> Inverse (-1.0)</span>
              <span class="flex items-center space-x-1"><span class="w-3 h-3 bg-slate-800 inline-block rounded"></span> Uncorrelated (0.0)</span>
              <span class="flex items-center space-x-1"><span class="w-3 h-3 bg-rose-500/40 border border-rose-400 inline-block rounded"></span> High Correlation (+1.0)</span>
            </div>
          </div>

          <!-- Correlation Insights & Discovered Lead-Lag Cascades -->
          <div class="lg:col-span-5 glass-card rounded-2xl p-4 flex flex-col space-y-3">
            <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider">Top Detected Stream Correlations</h3>
            <div id="top-correlations-list" class="flex-1 overflow-y-auto space-y-3 text-xs">
              <!-- Dynamically populated -->
            </div>
          </div>
        </div>
      </div>

      <!-- VIEW 4: AI NARRATIVE GENERATOR FULL PAGE -->
      <div id="view-narrative" class="view-panel hidden h-full p-4 flex flex-col space-y-4 overflow-y-auto">
        <div class="glass-card rounded-2xl p-4 flex justify-between items-center shrink-0">
          <div>
            <h2 class="text-lg font-bold text-slate-100 flex items-center space-x-2">
              <i class="fa-solid fa-brain text-brand-teal"></i>
              <span>AI Neighborhood Situation Narrative Hub</span>
            </h2>
            <p class="text-xs text-slate-400">Structured prompt synthesis combining statistical Z-scores, multi-variable anomaly scores, active work orders, and local weather alerts.</p>
          </div>
          <button onclick="switchView('overview')" class="px-3 py-1.5 rounded-xl bg-slate-800 text-xs font-mono text-slate-300 hover:bg-slate-700">
            ← Return to Dashboard
