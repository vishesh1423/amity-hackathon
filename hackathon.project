            <div id="narrative-full-output" class="flex-1 bg-slate-950/80 rounded-xl p-4 border border-white/5 overflow-y-auto space-y-4 text-xs leading-relaxed text-slate-200 font-sans">
              <!-- Rendered full report -->
            </div>
