      <!-- VIEW 5: LIVE STREAM INSPECTOR & RAW METRICS -->
      <div id="view-inspector" class="view-panel hidden h-full p-4 flex flex-col space-y-4 overflow-y-auto">
        <div class="glass-card rounded-2xl p-4 flex justify-between items-center shrink-0">
