        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 flex-1">
          <!-- Left: Prompt Context Inspector -->
          <div class="lg:col-span-5 glass-card rounded-2xl p-4 flex flex-col space-y-3">
            <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider">Generated Payload Context</h3>
            <pre id="narrative-payload-preview" class="flex-1 bg-slate-950 p-3 rounded-xl border border-white/5 font-mono text-[11px] text-brand-teal overflow-y-auto whitespace-pre-wrap">Loading payload context...</pre>
          </div>

          <!-- Right: Detailed AI Executive Narrative Output -->
          <div class="lg:col-span-7 glass-card rounded-2xl p-4 flex flex-col space-y-3 bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950">
            <div class="flex items-center justify-between">
              <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider">Executive Briefing Output</h3>
              <div class="flex items-center space-x-2">
                <button onclick="speakNarrative()" class="px-3 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-brand-emerald font-mono flex items-center space-x-2 border border-white/10">
                  <i class="fa-solid fa-volume-high"></i>
                  <span>SPEAK BRIEFING</span>
                </button>
                <button onclick="generateAINarrative()" class="px-3 py-1 rounded-lg bg-brand-teal text-slate-950 font-bold text-xs flex items-center space-x-2 shadow-lg shadow-cyan-500/20">
                  <i class="fa-solid fa-bolt"></i>
                  <span>SYNTHESIZE NOW</span>
                </button>
