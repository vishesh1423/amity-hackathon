        </div>
      </div>

    </main>
  </div>

  <div id="config-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md hidden items-center justify-center z-50 p-4">
    <div class="glass-card rounded-2xl max-w-md w-full p-5 space-y-4 border-brand-teal/30 shadow-2xl">
      <div class="flex justify-between items-center border-b border-white/10 pb-3">
        <h3 class="text-sm font-bold text-slate-100 flex items-center space-x-2">
          <i class="fa-solid fa-sliders text-brand-teal"></i>
          <span>Configuration & System API Keys</span>
        </h3>
        <button onclick="closeConfigModal()" class="text-slate-400 hover:text-slate-200">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="space-y-3 text-xs">
        <div>
          <label class="block text-slate-300 font-medium mb-1">Google Maps API Key</label>
          <input type="password" id="gmaps-api-key-input" placeholder="AIzaSy..." class="w-full bg-slate-950 border border-white/10 rounded-xl px-3 py-2 text-slate-100 font-mono text-xs focus:outline-none focus:border-brand-teal">
          <p class="text-[10px] text-slate-400 mt-1">Unlocks Google Maps vector roadmap, hybrid, and satellite spatial imagery layers.</p>
        </div>

        <div>
          <label class="block text-slate-300 font-medium mb-1">Google Gemini API Key (Optional)</label>
          <input type="password" id="gemini-api-key-input" placeholder="AIzaSy..." class="w-full bg-slate-950 border border-white/10 rounded-xl px-3 py-2 text-slate-100 font-mono text-xs focus:outline-none focus:border-brand-teal">
          <p class="text-[10px] text-slate-400 mt-1">If left empty, the application uses an internal mock synthesis LLM engine that emulates structured Gemini responses.</p>
        </div>

        <div>
          <label class="block text-slate-300 font-medium mb-1">Target Gemini Model</label>
          <select id="gemini-model-select" class="w-full bg-slate-950 border border-white/10 rounded-xl px-3 py-2 text-slate-100 font-mono text-xs focus:outline-none focus:border-brand-teal">
            <option value="gemini-3-flash-preview">gemini-3-flash-preview (Fastest / Recommended)</option>
            <option value="gemini-1.5-pro">gemini-1.5-pro (High Precision Context)</option>
          </select>
        </div>

        <div>
          <label class="block text-slate-300 font-medium mb-1">Anomaly Detection Sensitivity Threshold ($|Z| \ge$)</label>
          <input type="range" id="sensitivity-slider" min="1.5" max="3.5" step="0.1" value="2.0" oninput="document.getElementById('sensitivity-val').innerText = this.value" class="w-full accent-brand-teal">
          <div class="flex justify-between text-[10px] font-mono text-slate-400">
            <span>High Sensitivity (1.5)</span>
            <span id="sensitivity-val" class="text-brand-teal font-bold">2.0</span>
            <span>Low Sensitivity (3.5)</span>
          </div>
        </div>
      </div>

      <div class="flex justify-end space-x-2 pt-2 border-t border-white/10">
        <button onclick="closeConfigModal()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs text-slate-300">Save & Close</button>
      </div>
    </div>
  </div>

  <script>
    /* ==========================================================================
       1. DATA ARCHITECTURE & STATE MANAGEMENT
       ========================================================================== */

    // District Master Configuration Data & H3 Spatial Index Geometries
    const DISTRICTS = {
      downtown_harbor: {
        name: "Downtown Harbor District",
        h3Index: "#882a100d2bffff",
        coords: [40.7250, -73.9980],
        polygon: [
          [40.7300, -74.0040],
          [40.7320, -73.9920],
          [40.7260, -73.9860],
          [40.7180, -73.9920],
          [40.7180, -74.0040],
          [40.7240, -74.0100]
        ],
        baselines: {
          complaints311: 12.0,
          trafficSpeed: 32.0,
          aqi: 42.0,
          noise: 55.0,
          transitDelay: 3.5
        },
        activeWorkOrders: ["Pavement Repair #402", "Water Main Maintenance #109"]
      },
      financial_district: {
        name: "Financial & Civic Center",
        h3Index: "#882a100d2dffff",
        coords: [40.7128, -74.0060],
        polygon: [
          [40.7180, -74.0120],
          [40.7200, -74.0000],
          [40.7140, -73.9940],
          [40.7060, -74.0000],
          [40.7060, -74.0120],
          [40.7120, -74.0180]
        ],
        baselines: {
          complaints311: 8.5,
          trafficSpeed: 24.0,
          aqi: 48.0,
          noise: 62.0,
          transitDelay: 5.0
        },
        activeWorkOrders: ["Subway Signal Upgrade #881"]
      },
      midtown_center: {
        name: "Midtown Commercial Hub",
        h3Index: "#882a100d21ffff",
        coords: [40.7484, -73.9857],
        polygon: [
          [40.7540, -73.9920],
          [40.7560, -73.9800],
          [40.7500, -73.9740],
          [40.7420, -73.9800],
          [40.7420, -73.9920],
          [40.7480, -73.9980]
        ],
        baselines: {
          complaints311: 18.0,
          trafficSpeed: 18.0,
          aqi: 55.0,
          noise: 68.0,
          transitDelay: 7.2
        },
        activeWorkOrders: ["Traffic Light Re-timing #204", "Pedestrian Flow Audit"]
      },
      arts_warehouse_district: {
        name: "Arts & Warehouse Zone",
        h3Index: "#882a100d27ffff",
        coords: [40.7380, -74.0080],
        polygon: [
          [40.7440, -74.0140],
          [40.7460, -74.0020],
          [40.7400, -73.9960],
          [40.7320, -74.0020],
          [40.7320, -74.0140],
          [40.7380, -74.0200]
        ],
        baselines: {
          complaints311: 15.2,
          trafficSpeed: 28.0,
          aqi: 38.0,
          noise: 72.0,
          transitDelay: 2.1
        },
        activeWorkOrders: ["Event Sound Permit Inspection"]
      },
      industrial_port: {
        name: "Industrial Port & Logistics",
        h3Index: "#882a100d29ffff",
        coords: [40.7050, -74.0180],
        polygon: [
          [40.7110, -74.0240],
          [40.7130, -74.0120],
          [40.7070, -74.0060],
          [40.6990, -74.0120],
          [40.6990, -74.0240],
          [40.7050, -74.0300]
        ],
        baselines: {
          complaints311: 5.0,
          trafficSpeed: 38.0,
          aqi: 65.0,
          noise: 58.0,
          transitDelay: 4.0
        },
        activeWorkOrders: ["Freight Rail Crossing Maintenance"]
      },
      uptown_heights: {
        name: "Uptown Residential Heights",
        h3Index: "#882a100d23ffff",
        coords: [40.7620, -73.9720],
        polygon: [
          [40.7680, -73.9780],
          [40.7700, -73.9660],
          [40.7640, -73.9600],
          [40.7560, -73.9660],
          [40.7560, -73.9780],
          [40.7620, -73.9840]
        ],
        baselines: {
          complaints311: 9.0,
          trafficSpeed: 35.0,
          aqi: 30.0,
          noise: 45.0,
          transitDelay: 1.8
        },
        activeWorkOrders: ["Tree Trimming & Park Maintenance"]
      }
    };

    // Global Application State
    let appState = {
      selectedDistrictId: 'downtown_harbor',
      simulating: true,
      simSpeed: 1,
      timeStep: 0,
      sensitivityThreshold: 2.0,
      activeScenario: null,
      geminiApiKey: '',
      googleMapsApiKey: '',
      currentMapLayer: 'carto-dark',
      selectedModel: 'gemini-3-flash-preview',
      chartSelectedStream: 'all',
      districtsData: {},
      historicalTelemetry: {},
      anomalyLog: [],
      speechSynth: window.speechSynthesis || null,
      map: null,
      mapTileLayer: null,
      hexPolygons: {},
      telemetryChart: null
    };

    // Initialize Telemetry Buffer Arrays for each district
    function initDataStructures() {
      Object.keys(DISTRICTS).forEach(dId => {
        const base = DISTRICTS[dId].baselines;
        appState.districtsData[dId] = {
          current: { ...base },
          zScores: { complaints311: 0, trafficSpeed: 0, aqi: 0, noise: 0, transitDelay: 0 },
          isolationScore: 0.1,
          status: 'NORMAL' // NORMAL, CAUTION, CRITICAL
        };

        appState.historicalTelemetry[dId] = {
          timestamps: [],
          complaints311: [],
          trafficSpeed: [],
          aqi: [],
          noise: [],
          transitDelay: []
        };

        // Seed 15 historical points
        for (let i = 15; i >= 0; i--) {
          const timeLabel = new Date(Date.now() - i * 60000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
          appState.historicalTelemetry[dId].timestamps.push(timeLabel);
          appState.historicalTelemetry[dId].complaints311.push(base.complaints311 + (Math.random() * 4 - 2));
          appState.historicalTelemetry[dId].trafficSpeed.push(base.trafficSpeed + (Math.random() * 4 - 2));
          appState.historicalTelemetry[dId].aqi.push(base.aqi + (Math.random() * 6 - 3));
          appState.historicalTelemetry[dId].noise.push(base.noise + (Math.random() * 5 - 2.5));
          appState.historicalTelemetry[dId].transitDelay.push(base.transitDelay + (Math.random() * 2 - 1));
        }
      });
    }

    /* ==========================================================================
       2. REAL-TIME SIMULATION & STATISTICAL ANOMALY ENGINE
       ========================================================================== */

    function tickSimulation() {
      if (!appState.simulating) return;

      appState.timeStep++;
      const nowStr = new Date().toLocaleTimeString();
      document.getElementById('clock-display').innerText = nowStr;

      Object.keys(DISTRICTS).forEach(dId => {
        const base = DISTRICTS[dId].baselines;
        const current = appState.districtsData[dId].current;
        const hist = appState.historicalTelemetry[dId];

        // 1. Natural Ambient Noise Fluctuation
        current.complaints311 = Math.max(0, current.complaints311 + (Math.random() * 1.8 - 0.9));
        current.trafficSpeed = Math.max(2, current.trafficSpeed + (Math.random() * 2 - 1));
        current.aqi = Math.max(5, current.aqi + (Math.random() * 2.5 - 1.25));
        current.noise = Math.max(30, current.noise + (Math.random() * 2 - 1));
        current.transitDelay = Math.max(0, current.transitDelay + (Math.random() * 1 - 0.5));

        // 2. Scenario Perturbations (If injected into specific target district)
        if (appState.activeScenario && appState.selectedDistrictId === dId) {
          applyScenarioEffects(appState.activeScenario, current);
        }

        // 3. Update History Buffer (Keep last 20 ticks)
        hist.timestamps.push(nowStr);
        hist.complaints311.push(current.complaints311);
        hist.trafficSpeed.push(current.trafficSpeed);
        hist.aqi.push(current.aqi);
        hist.noise.push(current.noise);
        hist.transitDelay.push(current.transitDelay);

        if (hist.timestamps.length > 20) {
          hist.timestamps.shift();
          hist.complaints311.shift();
          hist.trafficSpeed.shift();
          hist.aqi.shift();
          hist.noise.shift();
          hist.transitDelay.shift();
        }

        // 4. Calculate Z-Scores & Isolation Anomaly Metric
        computeDistrictAnomalies(dId);
      });

      // Update UI components
      updateOverviewMetrics();
      updateMapHexColors();
      updateTelemetryChart();
      updateCorrelationMatrix();
      updateStreamInspectorTable();
    }

    function applyScenarioEffects(scenario, current) {
      switch (scenario) {
        case 'water_main':
          current.complaints311 += 4.5; // Water complaint surge
          current.trafficSpeed = Math.max(3, current.trafficSpeed - 3.2); // Traffic bottleneck
          break;
        case 'extreme_heat':
          current.aqi += 3.8;
          current.complaints311 += 2.2;
          current.transitDelay += 0.8;
          break;
        case 'noise_transit':
          current.noise += 4.0;
          current.transitDelay += 1.5;
          break;
        case 'air_quality':
          current.aqi += 6.5;
          current.complaints311 += 3.0;
          break;
      }
    }

    function computeDistrictAnomalies(dId) {
      const dist = appState.districtsData[dId];
      const hist = appState.historicalTelemetry[dId];
      const keys = ['complaints311', 'trafficSpeed', 'aqi', 'noise', 'transitDelay'];
      let maxAbsZ = 0;

      keys.forEach(k => {
        const arr = hist[k];
        const mean = arr.reduce((a, b) => a + b, 0) / arr.length;
        const stdDev = Math.sqrt(arr.reduce((a, b) => a + Math.pow(b - mean, 2), 0) / arr.length) || 1;
        const z = (dist.current[k] - mean) / stdDev;
        dist.zScores[k] = parseFloat(z.toFixed(2));

        if (Math.abs(z) > maxAbsZ) maxAbsZ = Math.abs(z);

        // Check against alert threshold
        if (Math.abs(z) >= appState.sensitivityThreshold) {
          logAnomalyAlert(dId, k, dist.current[k], z);
        }
      });

      // Synthetic Isolation Forest Anomaly Score approximation
      dist.isolationScore = Math.min(1.0, parseFloat((maxAbsZ / 4.5).toFixed(2)));

      // Determine Severity Status
      if (dist.isolationScore >= 0.65) {
        dist.status = 'CRITICAL';
      } else if (dist.isolationScore >= 0.35) {
        dist.status = 'CAUTION';
      } else {
        dist.status = 'NORMAL';
      }
    }

    function logAnomalyAlert(dId, metricKey, val, zScore) {
      const dName = DISTRICTS[dId].name;
      const metricLabels = {
        complaints311: '311 Complaint Surge',
        trafficSpeed: 'Traffic Bottleneck',
        aqi: 'Air Quality (AQI) Spike',
        noise: 'Acoustic / Noise Spike',
        transitDelay: 'Transit GTFS Delay'
      };

      const keyId = `${dId}-${metricKey}-${Math.floor(Date.now() / 10000)}`;
      if (appState.anomalyLog.some(a => a.id === keyId)) return;

      const severity = Math.abs(zScore) > 3.0 ? 'CRITICAL' : 'CAUTION';
      const alertObj = {
        id: keyId,
        timestamp: new Date().toLocaleTimeString(),
        districtName: dName,
        districtId: dId,
        metricLabel: metricLabels[metricKey],
        value: val.toFixed(1),
        zScore: zScore,
        severity: severity
      };

      appState.anomalyLog.unshift(alertObj);
      if (appState.anomalyLog.length > 25) appState.anomalyLog.pop();

      renderAnomalyLogList();
    }

    /* ==========================================================================
       3. CROSS-STREAM PEARSON CORRELATION ENGINE
       ========================================================================== */

    function computePearsonCorrelation(x, y) {
      const n = x.length;
      if (n < 2) return 0;
      let sumX = 0, sumY = 0, sumX2 = 0, sumY2 = 0, sumXY = 0;
      for (let i = 0; i < n; i++) {
        sumX += x[i];
        sumY += y[i];
        sumX2 += x[i] * x[i];
        sumY2 += y[i] * y[i];
        sumXY += x[i] * y[i];
      }
      const num = (n * sumXY) - (sumX * sumY);
      const den = Math.sqrt(((n * sumX2) - (sumX * sumX)) * ((n * sumY2) - (sumY * sumY)));
      return den === 0 ? 0 : parseFloat((num / den).toFixed(2));
    }

    function updateCorrelationMatrix() {
      const dId = appState.selectedDistrictId;
      const hist = appState.historicalTelemetry[dId];
      const keys = ['complaints311', 'trafficSpeed', 'aqi', 'noise', 'transitDelay'];
      const keyLabels = {
        complaints311: '311 Surge',
        trafficSpeed: 'Traffic Speed',
        aqi: 'Air Quality',
        noise: 'Noise Level',
        transitDelay: 'Transit Delay'
      };

      const tableEl = document.getElementById('correlation-table');
      if (!tableEl) return;

      let html = `<thead><tr><th class="p-2 border-b border-white/10 text-left text-slate-400">Stream</th>`;
      keys.forEach(k => {
        html += `<th class="p-2 border-b border-white/10 text-slate-300 font-bold">${keyLabels[k]}</th>`;
      });
      html += `</tr></thead><tbody>`;

      let topCorrelations = [];

      keys.forEach(k1 => {
        html += `<tr class="border-b border-white/5"><td class="p-2 text-left font-bold text-slate-300">${keyLabels[k1]}</td>`;
        keys.forEach(k2 => {
          const r = computePearsonCorrelation(hist[k1], hist[k2]);
          let bgClr = 'bg-slate-900/50 text-slate-400';
          if (r > 0.5) bgClr = 'bg-rose-500/30 text-rose-300 font-bold border border-rose-500/40';
          else if (r < -0.5) bgClr = 'bg-cyan-500/30 text-cyan-300 font-bold border border-cyan-500/40';
          
          html += `<td class="p-2 ${bgClr}">${r > 0 ? '+' : ''}${r.toFixed(2)}</td>`;

          if (k1 !== k2 && !topCorrelations.some(c => (c.k1 === k2 && c.k2 === k1))) {
            topCorrelations.push({ k1, k2, r, label1: keyLabels[k1], label2: keyLabels[k2] });
          }
        });
        html += `</tr>`;
      });
      html += `</tbody>`;
      tableEl.innerHTML = html;

      // Render Top Discoveries Card List
      topCorrelations.sort((a, b) => Math.abs(b.r) - Math.abs(a.r));
      const listEl = document.getElementById('top-correlations-list');
      if (listEl) {
        listEl.innerHTML = topCorrelations.slice(0, 4).map(c => `
          <div class="glass-card rounded-xl p-3 border border-white/10 flex items-center justify-between">
            <div>
              <div class="text-xs font-bold text-slate-100">${c.label1} <i class="fa-solid fa-arrows-rotate mx-1 text-brand-teal text-[10px]"></i> ${c.label2}</div>
              <div class="text-[10px] font-mono text-slate-400">Temporal Lead-Lag Window: ~10 mins</div>
            </div>
            <div class="text-right">
              <span class="px-2 py-1 rounded-lg text-xs font-mono font-bold ${Math.abs(c.r) > 0.6 ? 'bg-rose-500/20 text-rose-400 border border-rose-500/40' : 'bg-slate-800 text-slate-300'}">
                r = ${c.r > 0 ? '+' : ''}${c.r}
              </span>
            </div>
          </div>
        `).join('');
      }
    }

    /* ==========================================================================
       4. AI NARRATIVE GENERATOR (GEMINI API INTEGRATION + FALLBACK ENGINE)
       ========================================================================== */

    async function generateAINarrative() {
      const btn = document.getElementById('btn-generate-ai');
      const box = document.getElementById('narrative-box');
      const fullBox = document.getElementById('narrative-full-output');
      const payloadPreview = document.getElementById('narrative-payload-preview');

      btn.disabled = true;
      btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin text-xs"></i><span>SYNTHESIZING...</span>`;

      const dId = appState.selectedDistrictId;
      const district = DISTRICTS[dId];
      const data = appState.districtsData[dId];

      // Build Context Payload
      const contextPayload = {
        neighborhood: district.name,
        h3Index: district.h3Index,
        timestamp: new Date().toISOString(),
        isolationAnomalyScore: data.isolationScore,
        districtStatus: data.status,
        currentTelemetry: data.current,
        zScores: data.zScores,
        activeWorkOrders: district.activeWorkOrders,
        activeScenarioInjected: appState.activeScenario || "None (Standard Operating Baseline)"
      };

      if (payloadPreview) {
        payloadPreview.innerText = JSON.stringify(contextPayload, null, 2);
      }

      let narrativeResult = "";

      // Check if Gemini API key is provided
      if (appState.geminiApiKey && appState.geminiApiKey.trim().length > 10) {
        try {
          narrativeResult = await callGeminiAPI(contextPayload);
        } catch (err) {
          console.warn("Gemini API call failed, falling back to built-in heuristic engine:", err);
          narrativeResult = synthesizeHeuristicNarrative(contextPayload);
        }
      } else {
        // Use Built-in Emulated Gemini AI Engine
        await new Promise(r => setTimeout(r, 800)); // Simulate AI processing delay
        narrativeResult = synthesizeHeuristicNarrative(contextPayload);
      }

      // Render Narrative to UI
      const formattedHTML = formatNarrativeHTML(narrativeResult);
      box.innerHTML = formattedHTML;
      if (fullBox) fullBox.innerHTML = formattedHTML;

      document.getElementById('ai-timestamp').innerText = `LAST UPDATED: ${new Date().toLocaleTimeString()}`;
      document.getElementById('ai-model-tag').innerText = appState.geminiApiKey ? `ENGINE: ${appState.selectedModel}` : `ENGINE: GEMINI EMULATOR ENGINE`;

      btn.disabled = false;
      btn.innerHTML = `<i class="fa-solid fa-rotate text-xs"></i><span>GENERATE NARRATIVE</span>`;
    }

    async function callGeminiAPI(payload) {
      const promptText = `
SYSTEM INSTRUCTION: You are an expert municipal intelligence AI director explaining complex city sensor telemetry in simple, clear language to citizens and city official leadership.

PAYLOAD CONTEXT:
${JSON.stringify(payload, null, 2)}

Produce a response strictly adhering to this markdown structure:
### EXECUTIVE SUMMARY
[1-2 clear sentences explaining what is happening right now in the neighborhood.]

### ROOT CAUSE & CORRELATION
[Explain the primary driver of anomalies and how different streams interact, e.g., water main breaks causing traffic drops.]

### OPERATIONAL IMPACT & ACTIONS
[State citizen impact and action status on active work orders.]
`;

      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/${appState.selectedModel}:generateContent?key=${appState.geminiApiKey}`;
      
      const response = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [{ text: promptText }] }]
        })
      });

      const resData = await response.json();
      return resData.candidates[0].content.parts[0].text;
    }

    function synthesizeHeuristicNarrative(p) {
      const name = p.neighborhood;
      const status = p.districtStatus;

      if (status === 'CRITICAL') {
        if (p.zScores.complaints311 > 2.0 && p.zScores.trafficSpeed < -1.5) {
          return `### EXECUTIVE SUMMARY
Severe cascading disruption detected in **${name}**. A sudden surge in 311 utility reports is directly linked to localized traffic stagnation.

### ROOT CAUSE & CORRELATION
A suspected water infrastructure failure on primary thoroughfares has caused 311 complaint volume to spike to **${p.currentTelemetry.complaints311.toFixed(1)} req/hr** (Z-score: +${p.zScores.complaints311}). Consequently, vehicle transit speeds dropped significantly to **${p.currentTelemetry.trafficSpeed.toFixed(1)} mph**.

### OPERATIONAL IMPACT & ACTIONS
Municipal utility teams (${p.activeWorkOrders[0] || 'Emergency Dispatch'}) have been mobilized for immediate site intervention. Motorists are advised to utilize alternate ring roads.`;
        } else if (p.zScores.aqi > 2.0) {
          return `### EXECUTIVE SUMMARY
Air Quality Warning active in **${name}**. Particulate matter levels have exceeded standard urban safety thresholds.

### ROOT CAUSE & CORRELATION
Environmental sensors register an AQI peak of **${p.currentTelemetry.aqi.toFixed(1)}** (Z-score: +${p.zScores.aqi}). Correlated telemetry indicates increased industrial freight activity and ambient thermal inversion.

### OPERATIONAL IMPACT & ACTIONS
Public health advisories issued for sensitive groups. Air quality monitoring units are conducting active sensor audits.`;
        }
      }

      return `### EXECUTIVE SUMMARY
**${name}** is operating under **${status}** conditions with minimal spatial anomaly variance across municipal sensor networks.

### ROOT CAUSE & CORRELATION
All telemetry streams including 311 calls (${p.currentTelemetry.complaints311.toFixed(1)} req/hr), traffic speeds (${p.currentTelemetry.trafficSpeed.toFixed(1)} mph), and ambient air quality (${p.currentTelemetry.aqi.toFixed(1)} AQI) remain within nominal statistical bounds.

### OPERATIONAL IMPACT & ACTIONS
Routine city maintenance operations are underway (${p.activeWorkOrders.join(', ') || 'Standard Patrols'}). No active public advisories required.`;
    }

    function formatNarrativeHTML(text) {
      return text
        .replace(/### EXECUTIVE SUMMARY/g, '<h4 class="text-brand-teal font-bold text-xs uppercase tracking-wider mt-1 mb-0.5"><i class="fa-solid fa-bullhorn mr-1.5"></i>Executive Summary</h4>')
        .replace(/### ROOT CAUSE & CORRELATION/g, '<h4 class="text-brand-amber font-bold text-xs uppercase tracking-wider mt-2.5 mb-0.5"><i class="fa-solid fa-diagram-project mr-1.5"></i>Root Cause & Cross-Stream Correlations</h4>')
        .replace(/### OPERATIONAL IMPACT & ACTIONS/g, '<h4 class="text-brand-emerald font-bold text-xs uppercase tracking-wider mt-2.5 mb-0.5"><i class="fa-solid fa-truck-medical mr-1.5"></i>Operational Impact & Action Items</h4>')
        .replace(/\*\*(.*?)\*\*/g, '<strong class="text-slate-100 font-semibold">$1</strong>');
    }

    /* Speech Audio Synthesis */
    function speakNarrative() {
      if (!appState.speechSynth) {
        alert("Web Speech API is not supported in this browser.");
        return;
      }

      const box = document.getElementById('narrative-box');
      if (!box) return;

      const cleanText = box.innerText;
      if (appState.speechSynth.speaking) {
        appState.speechSynth.cancel();
        document.getElementById('btn-speak').classList.remove('bg-brand-emerald', 'text-slate-950');
        return;
      }

      const utterance = new SpeechSynthesisUtterance(cleanText);
      utterance.rate = 1.0;
      utterance.pitch = 1.0;

      utterance.onstart = () => {
        document.getElementById('btn-speak').classList.add('bg-brand-emerald', 'text-slate-950');
      };

      utterance.onend = () => {
        document.getElementById('btn-speak').classList.remove('bg-brand-emerald', 'text-slate-950');
      };

      appState.speechSynth.speak(utterance);
    }

    /* ==========================================================================
       5. USER INTERACTION, UI RENDERING & MAP INITIALIZATION
       ========================================================================== */

    function initMap() {
      // Centered on Downtown Harbor District
      appState.map = L.map('spatial-map', {
        zoomControl: false,
        attributionControl: false
      }).setView([40.7250, -73.9980], 13);

      // Default Dark Matter Map Tiles
      appState.mapTileLayer = L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        maxZoom: 19
      }).addTo(appState.map);

      // Render Hexagonal District Polygons
      Object.keys(DISTRICTS).forEach(dId => {
        const dist = DISTRICTS[dId];
        const poly = L.polygon(dist.polygon, {
          color: '#00f2fe',
          weight: 2,
          fillColor: '#00f5a0',
          fillOpacity: 0.35,
          className: 'hex-poly'
        }).addTo(appState.map);

        poly.on('click', () => {
          changeSelectedDistrict(dId);
        });

        poly.bindTooltip(`<b>${dist.name}</b><br>H3: ${dist.h3Index}`, {
          permanent: false,
          direction: 'top',
          className: 'glass-card text-xs text-slate-100 font-mono border-white/10'
        });

        appState.hexPolygons[dId] = poly;
      });
    }

    function changeMapLayer(layerType) {
      if (!appState.map) return;
      appState.currentMapLayer = layerType;

      if (appState.mapTileLayer) {
        appState.map.removeLayer(appState.mapTileLayer);
      }

      const key = appState.googleMapsApiKey ? `&key=${appState.googleMapsApiKey}` : '';

      switch (layerType) {
        case 'gmaps-roadmap':
          appState.mapTileLayer = L.tileLayer(`https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}${key}`, { maxZoom: 20 });
          break;
        case 'gmaps-satellite':
          appState.mapTileLayer = L.tileLayer(`https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}${key}`, { maxZoom: 20 });
          break;
        case 'gmaps-hybrid':
          appState.mapTileLayer = L.tileLayer(`https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}${key}`, { maxZoom: 20 });
          break;
        case 'gmaps-terrain':
          appState.mapTileLayer = L.tileLayer(`https://mt1.google.com/vt/lyrs=p&x={x}&y={y}&z={z}${key}`, { maxZoom: 20 });
          break;
        case 'carto-dark':
        default:
          appState.mapTileLayer = L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', { maxZoom: 19 });
          break;
      }

      appState.mapTileLayer.addTo(appState.map);
    }

    function updateMapHexColors() {
      Object.keys(DISTRICTS).forEach(dId => {
        const poly = appState.hexPolygons[dId];
        if (!poly) return;

        const status = appState.districtsData[dId].status;
        const isSelected = dId === appState.selectedDistrictId;

        let strokeClr = isSelected ? '#00f2fe' : 'rgba(255,255,255,0.2)';
        let fillClr = '#00f5a0'; // Normal

        if (status === 'CAUTION') fillClr = '#ffb703';
        if (status === 'CRITICAL') fillClr = '#f72585';

        poly.setStyle({
          color: strokeClr,
          weight: isSelected ? 3 : 1.5,
          fillColor: fillClr,
          fillOpacity: isSelected ? 0.6 : 0.35
        });
      });
    }

    function initTelemetryChart() {
      if (typeof Chart === 'undefined') {
        console.warn('Chart.js library is not ready yet. Retrying chart initialization in 300ms...');
        setTimeout(initTelemetryChart, 300);
        return;
      }

      const canvas = document.getElementById('telemetryChart');
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      appState.telemetryChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: [],
          datasets: [
            {
              label: '311 Complaints',
              borderColor: '#00f2fe',
              backgroundColor: 'rgba(0, 242, 254, 0.1)',
              data: [],
              tension: 0.3,
              fill: true
            },
            {
              label: 'Traffic Speed (mph)',
              borderColor: '#ffb703',
              backgroundColor: 'transparent',
              data: [],
              tension: 0.3
            },
            {
              label: 'AQI Index',
              borderColor: '#00f5a0',
              backgroundColor: 'transparent',
              data: [],
              tension: 0.3
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: { duration: 300 },
          plugins: {
            legend: {
              labels: { color: '#94a3b8', font: { family: 'JetBrains Mono', size: 10 } }
            }
          },
          scales: {
            x: {
              grid: { color: 'rgba(255,255,255,0.05)' },
              ticks: { color: '#64748b', font: { size: 9 } }
            },
            y: {
              grid: { color: 'rgba(255,255,255,0.05)' },
              ticks: { color: '#64748b', font: { size: 9 } }
            }
          }
        }
      });
    }

    function updateTelemetryChart() {
      if (!appState.telemetryChart) return;
      const dId = appState.selectedDistrictId;
      const hist = appState.historicalTelemetry[dId];

      appState.telemetryChart.data.labels = hist.timestamps;
      appState.telemetryChart.data.datasets[0].data = hist.complaints311;
      appState.telemetryChart.data.datasets[1].data = hist.trafficSpeed;
    
